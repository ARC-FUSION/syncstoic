# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files we want to normalize on checkout and
# convert to native line endings on checkout.
*.css text
*.html text
*.js text
*.json text
*.md text
*.svg text
*.ts text
*.tsx text
*.xml text
*.yml text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
